<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Personal academic portfolio of <%=p.name%>, prospective PhD applicant in computer systems."><title><%=p.name%> — Portfolio</title><link rel="stylesheet" href="./assets/css/style.css"></head><body>
<header class="site-header"><div class="container nav-inner"><a href="#home" class="wordmark"><%=p.name%></a><nav aria-label="Navigation"><a href="#about">About</a><a href="#research">Research</a><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="./blog.html">Blog</a><a href="#education">Education</a><a href="#skills">Skills</a><a href="#contact">Contact</a><a href="<%=p.cv_url%>" target="_blank" rel="noopener">CV ↗</a></nav></div></header>
<main id="home">
<section class="intro container" id="about"><div class="intro-copy"><p class="eyebrow"><%=p.phd_status%></p><h1><%=p.headline%></h1><p><%=p.intro%></p><p><%=p.intro2%></p><div class="interests-inline"><h2>Research interests</h2><p><%=p.research_interest_summary%></p></div><div class="intro-actions"><a class="btn secondary" href="#projects">Selected work ↗</a><a class="btn secondary" href="<%=p.cv_url%>" target="_blank" rel="noopener">CV (placeholder) ↗</a></div></div><figure class="portrait-card"><img src="<%=p.photo%>" alt="Temporary placeholder portrait of Donald Trump; not the website owner's photo"><figcaption><%=p.photo_note%></figcaption></figure></section>
<section class="section container" id="research"><div class="section-heading"><div><p class="eyebrow">01 / ACADEMIC WORK</p><h2>Research</h2></div></div><div class="research-stack"><%p.research.forEach(x=>{%><article class="content-card"><p class="eyebrow"><%=x.kind%></p><h3><%=x.title%></h3><p><%=x.description%></p><div class="inline-links"><%x.links.forEach(l=>{%><a href="<%=l.url%>" target="_blank" rel="noopener"><%=l.label%> ↗</a><%})%></div></article><%})%></div></section>
<section class="section container" id="experience"><div class="section-heading"><div><p class="eyebrow">02 / WORK</p><h2>Professional experience</h2></div></div><%p.experience.forEach(e=>{%><div class="work-head"><div><h3><%=e.name%></h3><p><%=e.role%></p></div><span><%=e.period%></span></div><div class="two-col"><%e.projects.forEach(x=>{%><article class="content-card"><h3><%=x.title%></h3><ul><%(x.bullets||[]).forEach(b=>{%><li><%=b%></li><%})%></ul></article><%})%></div><%})%></section>
<section class="section container" id="projects"><div class="section-heading"><div><p class="eyebrow">03 / WORK I HAVE BUILT</p><h2>Projects</h2></div><p>Selected implementations, experiments, utilities, and games.</p></div><%['Experimental Projects','Selected Systems Projects','Tools','Games'].forEach((group,ix)=>{%><div class="project-category"><h3><%=group%></h3><div class="project-grid"><%p.projects.filter(x=>x.category===group).forEach(x=>{%><article class="project-card"><p class="project-meta"><%=x.subtitle%> · <%=x.date%></p><h4><%=x.title%></h4><p><%=x.description%></p><div class="tags"><%x.tags.forEach(t=>{%><span class="tag"><%=t%></span><%})%></div><%if(x.advisor){%><a class="minor-link" href="<%=x.advisor.url%>" target="_blank" rel="noopener"><%=x.advisor.label%> ↗</a><%}%><%if(x.url){%><a class="project-link" href="<%=x.url%>" target="_blank" rel="noopener">View repository ↗</a><%}else{%><span class="no-link">Repository link to be added</span><%}%></article><%})%></div></div><%})%></section>
<section class="section container" id="education"><div class="section-heading"><div><p class="eyebrow">04 / BACKGROUND</p><h2>Education</h2></div></div><article class="content-card"><h3><%=p.education.school%></h3><p class="degree"><%=p.education.degree%> · <%=p.education.location%></p><p class="subtle"><%=p.education.graduation%></p><h4>Notable coursework</h4><div class="tags"><%p.education.courses.forEach(x=>{%><span class="tag"><%=x%></span><%})%></div></article></section>
<section class="section container" id="skills"><div class="section-heading"><div><p class="eyebrow">05 / TECHNICAL BACKGROUND</p><h2>Skills</h2></div></div><div class="skills-grid"><%p.skills.forEach(g=>{%><article class="content-card"><h3><%=g.title%></h3><div class="tags"><%g.items.forEach(t=>{%><span class="tag"><%=t%></span><%})%></div></article><%})%></div></section>
<section class="section container" id="contact"><div class="section-heading"><div><p class="eyebrow">06 / GET IN TOUCH</p><h2>Contact</h2></div></div><div class="content-card contact-card"><p>For academic correspondence or questions about my projects, you can reach me through the links below.</p><div class="inline-links"><%if(p.email){%><a href="mailto:<%=p.email%>">Email ↗</a><%}else{%><span>Email address: add in data/profile.json</span><%}%><a href="<%=p.github%>" target="_blank" rel="noopener">GitHub ↗</a><%if(p.linkedin){%><a href="<%=p.linkedin%>" target="_blank" rel="noopener">LinkedIn ↗</a><%}else{%><span>LinkedIn · add profile URL</span><%}%></div><p class="subtle">Dhaka, Bangladesh</p></div></section>
<section class="section container" id="cv"><div class="section-heading"><div><p class="eyebrow">07 / CURRICULUM VITAE</p><h2>CV</h2></div></div><div class="content-card compact-card"><p>A concise overview of my education, research experience, and selected projects.</p><a href="<%=p.cv_url%>" target="_blank" rel="noopener">View CV (placeholder URL) ↗</a></div></section>
</main><footer class="container footer"><span>© 2026 <%=p.name%></span><a href="#home">Back to top ↑</a></footer><script src="./assets/js/script.js"></script></body></html>